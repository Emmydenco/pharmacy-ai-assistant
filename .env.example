# Safe default: no network request and clearly labelled deterministic replies.
LLM_PROVIDER=mock
LLM_MODEL=@cf/meta/llama-3.2-3b-instruct
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=500

# Required only when LLM_PROVIDER=cloudflare. Keep these values server-side.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Backward-compatible aliases accepted by the prototype:
# APP_MODE=mock
# CLOUDFLARE_MODEL=@cf/meta/llama-3.2-3b-instruct
# PROVIDER_TIMEOUT_SECONDS=20
